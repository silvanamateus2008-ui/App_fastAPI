APP_NAME=API Fabrica
ENVIRONMENT=development
# En desarrollo vacia genera una clave aleatoria; en produccion define una clave segura.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=sqlite:///./fabrica.db
# PostgreSQL con psycopg 3:
# DATABASE_URL=postgresql+psycopg://<usuario>:<contrasena>@<host>:5432/<base>
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_NOMBRE=
SEED_ADMIN_PASSWORD=
SEED_ALMACEN_EMAIL=
SEED_ALMACEN_USERNAME=
SEED_ALMACEN_NOMBRE=
SEED_ALMACEN_PASSWORD=
SEED_VENTAS_EMAIL=
SEED_VENTAS_USERNAME=
SEED_VENTAS_NOMBRE=
SEED_VENTAS_PASSWORD=
